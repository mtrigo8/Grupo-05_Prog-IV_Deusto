# ─── Carpetas de compilacion (Eclipse CDT) ───────────────────────────────────
/Debug/
/Release/

# ─── Archivos compilados ──────────────────────────────────────────────────────
*.o
*.a
*.so
*.exe
*.out
*.d

# ─── Archivos de runtime (distintos en cada maquina) ─────────────────────────
# client.config → configuracion local (usa client.config.example como plantilla)
*.log
client.config

# ─── Eclipse: archivos generados por maquina (contienen rutas absolutas) ─────
.settings/language.settings.xml

# ─── Sistemas operativos ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
